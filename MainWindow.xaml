<Window x:Class="SandboxTimeline.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:ui="http://schemas.modernwpf.com/2019"

        ui:WindowHelper.UseModernWindowStyle="True"

        Title="{DynamicResource Str_WindowTitle}"

        Width="1200"

        Height="800"

        MinWidth="840"

        MinHeight="520"

        FontFamily="{StaticResource UiFontFamily}"

        WindowStartupLocation="CenterScreen"

        ShowInTaskbar="True"

        Background="{StaticResource SurfaceBrush}"

        RenderOptions.BitmapScalingMode="HighQuality"

        RenderOptions.ClearTypeHint="Enabled"

        TextOptions.TextFormattingMode="Display"

        UseLayoutRounding="True"

        SnapsToDevicePixels="True">

    <Grid x:Name="RootGrid"

          VerticalAlignment="Stretch"

          HorizontalAlignment="Stretch"

          Background="{StaticResource SurfaceBrush}"

          UseLayoutRounding="True"

          SnapsToDevicePixels="True">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

        </Grid.RowDefinitions>



        <Grid Grid.Row="0"

              VerticalAlignment="Top"

              Margin="40,36,40,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top">

                <TextBlock Text="{DynamicResource Str_AppTitle}"

                           Style="{StaticResource TitleTextStyle}" />

                <TextBlock x:Name="AppSubtitleText"

                           Style="{StaticResource SubtitleTextStyle}"

                           Margin="0,8,0,0" />

                <TextBlock x:Name="PremiumTaglineText"

                           Text="{DynamicResource Str_PremiumRecoveryTagline}"

                           FontFamily="{StaticResource UiFontFamily}"

                           FontSize="13"

                           FontWeight="SemiBold"

                           Foreground="{StaticResource AccentBrush}"

                           TextWrapping="Wrap"

                           Margin="0,6,0,0" />

            </StackPanel>

            <StackPanel Grid.Column="1"

                        VerticalAlignment="Top"

                        Margin="24,4,0,0">

                <Border x:Name="LicenseBadgeBorder"
                        Background="{StaticResource CardElevatedBrush}"

                        BorderBrush="{StaticResource CardBorderBrush}"

                        BorderThickness="1"

                        CornerRadius="12"

                        Padding="14,8"

                        Effect="{StaticResource CardShadowEffect}">

                    <TextBlock x:Name="LicenseBadge"

                               Text="{DynamicResource Str_LicenseBadgeFree}"

                               FontFamily="{StaticResource UiFontFamily}"

                               FontSize="13"

                               FontWeight="SemiBold"

                               Foreground="{StaticResource SubtleForegroundBrush}" />

                </Border>

            </StackPanel>

        </Grid>



        <Grid x:Name="ContentHostGrid"

              Grid.Row="1"

              VerticalAlignment="Stretch"

              Margin="40,28,40,40">

            <Border x:Name="MainContentCard"

                    VerticalAlignment="Stretch"

                    HorizontalAlignment="Stretch"

                    Background="{StaticResource CardBrush}"

                    BorderBrush="{StaticResource CardBorderBrush}"

                    BorderThickness="1"

                    CornerRadius="12"

                    Padding="32,28,32,48"

                    ClipToBounds="False"

                    Effect="{StaticResource CardShadowEffect}">

                <Grid x:Name="MainContentDock"

                      VerticalAlignment="Stretch">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>



                    <StackPanel Grid.Row="0"

                                VerticalAlignment="Top">

                        <StackPanel Margin="0,0,0,24">

                            <TextBlock Text="{DynamicResource Str_SystemTimeSlider}"

                                       Style="{StaticResource SectionTitleTextStyle}" />

                            <TextBlock Text="{DynamicResource Str_SystemTimeSliderDesc}"

                                       Style="{StaticResource BodyTextStyle}"

                                       TextWrapping="Wrap"

                                       Margin="0,8,0,0" />

                        </StackPanel>



                        <Grid Margin="0,0,0,12">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{DynamicResource Str_TimelinePast}"

                                       FontFamily="{StaticResource UiFontFamily}"

                                       FontSize="13"

                                       FontWeight="SemiBold"

                                       Foreground="{StaticResource AccentBrush}"

                                       HorizontalAlignment="Left" />

                            <TextBlock Grid.Column="1"

                                       Text="{DynamicResource Str_TimelineCurrent}"

                                       FontFamily="{StaticResource UiFontFamily}"

                                       FontSize="13"

                                       FontWeight="SemiBold"

                                       Foreground="{StaticResource SubtleForegroundBrush}"

                                       HorizontalAlignment="Right" />

                        </Grid>



                        <Slider x:Name="TimelineSlider"

                                Style="{StaticResource TimelineSliderStyle}"

                                Height="44"

                                MinHeight="44"

                                MaxHeight="44"

                                VerticalAlignment="Top"

                                ValueChanged="TimelineSlider_ValueChanged"

                                ToolTipService.ToolTip="{DynamicResource Str_TimelineSliderToolTip}"

                                Margin="0,4,0,20" />



                        <Grid VerticalAlignment="Top" Margin="0,0,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock x:Name="SelectedSnapshotLabel"

                                           FontFamily="{StaticResource UiFontFamily}"

                                           Text="{DynamicResource Str_NoSnapshotsYet}"

                                           FontSize="22"

                                           FontWeight="SemiBold"

                                           Foreground="{StaticResource PrimaryForegroundBrush}"

                                           TextWrapping="Wrap" />

                                <TextBlock x:Name="SelectedSnapshotTime"

                                           Style="{StaticResource BodyTextStyle}"

                                           TextWrapping="Wrap"

                                           Margin="0,6,0,0" />

                            </StackPanel>

                            <TextBlock x:Name="SnapshotCountLabel"

                                       Grid.Column="1"

                                       Style="{StaticResource BodyTextStyle}"

                                       VerticalAlignment="Top"

                                       Margin="20,4,0,0" />

                        </Grid>



                        <UniformGrid Columns="3"

                                     Margin="0,28,0,0"

                                     VerticalAlignment="Top"

                                     MinHeight="48">

                            <Button x:Name="TakeSnapshotButton"

                                    Content="{DynamicResource Str_TakeSnapshot}"

                                    Style="{StaticResource PrimaryButtonStyle}"

                                    MinHeight="48"

                                    Margin="0,0,10,0"

                                    Click="TakeSnapshot_Click"

                                    ToolTipService.ToolTip="{DynamicResource Str_TakeSnapshotToolTip}" />

                            <Button x:Name="RollbackButton"

                                    Content="{DynamicResource Str_RollbackNow}"

                                    Style="{StaticResource PrimaryButtonStyle}"

                                    MinHeight="48"

                                    Margin="5,0"

                                    Click="Rollback_Click"

                                    ToolTipService.ToolTip="{DynamicResource Str_RollbackNowToolTip}" />

                            <Button x:Name="SandboxToggleButton"

                                    Content="{DynamicResource Str_SandboxGuardOn}"

                                    Style="{StaticResource SecondaryButtonStyle}"

                                    MinHeight="48"

                                    Margin="10,0,0,0"

                                    Click="SandboxToggle_Click"

                                    ToolTipService.ToolTip="{DynamicResource Str_SandboxGuardToolTip}" />

                        </UniformGrid>

                    </StackPanel>



                    <Border x:Name="LayoutFillSpacer"

                            Grid.Row="1"

                            Background="Transparent"

                            VerticalAlignment="Stretch"

                            MinHeight="0" />



                    <Border x:Name="LicenseFooterPanel"

                            Grid.Row="2"

                            VerticalAlignment="Top"

                            HorizontalAlignment="Stretch"

                            Background="Transparent"

                            ClipToBounds="False">

                        <StackPanel VerticalAlignment="Top">

                            <Border Height="1"

                                    Margin="0,28,0,20"

                                    Background="{StaticResource CardBorderBrush}"

                                    Opacity="0.6" />



                            <TextBlock x:Name="StatusText"
                                       Text="{DynamicResource Str_StatusReady}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource PrimaryForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />



                            <Border Height="1"

                                    Margin="0,16,0,0"

                                    Background="{StaticResource CardBorderBrush}"

                                    Opacity="0.6" />



                            <Expander x:Name="LicenseExpander"

                                      Header="{DynamicResource Str_ActivatePremiumLicense}"

                                      Margin="0,12,0,0"

                                      ExpandDirection="Down"

                                      HorizontalAlignment="Stretch"

                                      HorizontalContentAlignment="Left"

                                      VerticalAlignment="Top"

                                      VerticalContentAlignment="Top"

                                      FontFamily="{StaticResource UiFontFamily}"

                                      FontSize="15"

                                      FontWeight="SemiBold"

                                      Foreground="{StaticResource PrimaryForegroundBrush}"

                                      Background="Transparent"

                                      BorderThickness="0"

                                      Padding="0,4,0,8"

                                      ClipToBounds="False"

                                      IsExpanded="False">

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="120">

                                    <Border VerticalAlignment="Top"

                                            ClipToBounds="False"

                                            Padding="0,8,0,4">

                                        <Grid Margin="10,10,10,10">

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="Auto" />

                                                <RowDefinition Height="Auto" />

                                            </Grid.RowDefinitions>



                                            <StackPanel x:Name="LicenseInputPanel"

                                                        Grid.Row="0"

                                                        Orientation="Horizontal"

                                                        VerticalAlignment="Top"

                                                        HorizontalAlignment="Left">

                                                <TextBox x:Name="LicenseKeyBox"

                                                         ui:ControlHelper.PlaceholderText="{DynamicResource Str_EnterLicenseKey}"

                                                         Width="320"

                                                         MinHeight="36"

                                                         HorizontalAlignment="Left"

                                                         VerticalAlignment="Center"

                                                         VerticalContentAlignment="Center"

                                                         Padding="14,8"

                                                         FontFamily="{StaticResource UiFontFamily}"

                                                         Background="{StaticResource CardElevatedBrush}"

                                                         BorderBrush="{StaticResource CardBorderBrush}"

                                                         Foreground="{StaticResource PrimaryForegroundBrush}" />



                                                <Button x:Name="ValidateLicenseButton"

                                                        Content="{DynamicResource Str_ValidateLicense}"

                                                        Width="140"

                                                        MinHeight="36"

                                                        Background="#007ACC"

                                                        Foreground="White"

                                                        Margin="10,0,0,0"

                                                        VerticalAlignment="Center"

                                                        BorderThickness="0"

                                                        FontFamily="{StaticResource UiFontFamily}"

                                                        FontSize="13"

                                                        FontWeight="SemiBold"

                                                        Padding="12,6"

                                                        Cursor="Hand"

                                                        Click="ActivateLicense_Click" />

                                                <Button x:Name="BtnRetry"

                                                        Content="{DynamicResource Str_BtnRetry}"

                                                        Width="100"

                                                        MinHeight="36"

                                                        Visibility="Collapsed"

                                                        Margin="10,0,0,0"

                                                        VerticalAlignment="Center"

                                                        Background="{StaticResource CardElevatedBrush}"

                                                        BorderBrush="{StaticResource CardBorderBrush}"

                                                        BorderThickness="1"

                                                        Foreground="{StaticResource PrimaryForegroundBrush}"

                                                        FontFamily="{StaticResource UiFontFamily}"

                                                        FontSize="13"

                                                        FontWeight="SemiBold"

                                                        Padding="8,6"

                                                        Cursor="Hand"

                                                        Click="BtnRetry_Click" />

                                            </StackPanel>



                                            <StackPanel x:Name="LicenseErrorPanel"

                                                        Grid.Row="1"

                                                        Orientation="Horizontal"

                                                        Visibility="Collapsed"

                                                        Margin="0,10,0,0"

                                                        VerticalAlignment="Top"

                                                        HorizontalAlignment="Left">

                                                <TextBlock x:Name="LicenseErrorText"

                                                           Text="{DynamicResource Str_LicenseErrorOneLine}"

                                                           Style="{StaticResource BodyTextStyle}"

                                                           Foreground="#FF6B6B"

                                                           TextWrapping="Wrap"

                                                           VerticalAlignment="Center" />

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </ScrollViewer>

                            </Expander>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

        </Grid>



        <Border x:Name="WelcomeOverlay"

                Grid.RowSpan="2"

                VerticalAlignment="Stretch"

                HorizontalAlignment="Stretch"

                Visibility="Collapsed"

                Background="#CC0A0A0F"

                Panel.ZIndex="100">

            <Border.RenderTransform>

                <ScaleTransform x:Name="WelcomeOverlayScale" ScaleX="0.96" ScaleY="0.96" />

            </Border.RenderTransform>

            <Border x:Name="WelcomeDialogCard"

                    VerticalAlignment="Center"

                    HorizontalAlignment="Center"

                    Width="540"

                    MinHeight="420"

                    MaxHeight="560"

                    Background="{StaticResource CardBrush}"

                    BorderBrush="{StaticResource AccentBrush}"

                    BorderThickness="1"

                    CornerRadius="12"

                    Margin="24"

                    ClipToBounds="True"

                    Effect="{StaticResource CardShadowEffect}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>



                    <ScrollViewer Grid.Row="0"

                                  MaxHeight="400"

                                  VerticalScrollBarVisibility="Auto"

                                  HorizontalScrollBarVisibility="Disabled"

                                  Padding="32,28,32,12">

                        <StackPanel>

                            <TextBlock Text="{DynamicResource Str_WelcomeTitle}"

                                       FontFamily="{StaticResource UiFontFamily}"

                                       FontSize="24"

                                       FontWeight="SemiBold"

                                       Foreground="{StaticResource PrimaryForegroundBrush}"

                                       TextWrapping="Wrap"

                                       Margin="0,0,0,10" />

                            <TextBlock Text="{DynamicResource Str_WelcomeSubtitle}"

                                       Style="{StaticResource BodyTextStyle}"

                                       TextWrapping="Wrap"

                                       Margin="0,0,0,20" />



                            <Border Background="{StaticResource CardElevatedBrush}"

                                    BorderBrush="{StaticResource CardBorderBrush}"

                                    BorderThickness="1"

                                    CornerRadius="12"

                                    Padding="16,14"

                                    Margin="0,0,0,10">

                                <StackPanel>

                                    <TextBlock Text="{DynamicResource Str_WelcomeTakeSnapshotTitle}"

                                               FontFamily="{StaticResource UiFontFamily}"

                                               FontWeight="SemiBold"

                                               Foreground="{StaticResource PrimaryForegroundBrush}"

                                               Margin="0,0,0,6" />

                                    <TextBlock Text="{DynamicResource Str_WelcomeTakeSnapshotBody}"

                                               Style="{StaticResource BodyTextStyle}"

                                               TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>



                            <Border Background="{StaticResource CardElevatedBrush}"

                                    BorderBrush="{StaticResource CardBorderBrush}"

                                    BorderThickness="1"

                                    CornerRadius="12"

                                    Padding="16,14"

                                    Margin="0,0,0,10">

                                <StackPanel>

                                    <TextBlock Text="{DynamicResource Str_WelcomeHotkeyTitle}"

                                               FontFamily="{StaticResource UiFontFamily}"

                                               FontWeight="SemiBold"

                                               Foreground="{StaticResource PrimaryForegroundBrush}"

                                               Margin="0,0,0,6" />

                                    <TextBlock x:Name="WelcomeHotkeyBodyText"

                                               Style="{StaticResource BodyTextStyle}"

                                               TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>



                            <Border Background="{StaticResource CardElevatedBrush}"

                                    BorderBrush="{StaticResource CardBorderBrush}"

                                    BorderThickness="1"

                                    CornerRadius="12"

                                    Padding="16,14"

                                    Margin="0,0,0,10">

                                <StackPanel>

                                    <TextBlock Text="{DynamicResource Str_WelcomeSliderTitle}"

                                               FontFamily="{StaticResource UiFontFamily}"

                                               FontWeight="SemiBold"

                                               Foreground="{StaticResource PrimaryForegroundBrush}"

                                               Margin="0,0,0,6" />

                                    <TextBlock Text="{DynamicResource Str_WelcomeSliderBody}"

                                               Style="{StaticResource BodyTextStyle}"

                                               TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>



                            <Border Background="{StaticResource CardElevatedBrush}"

                                    BorderBrush="{StaticResource CardBorderBrush}"

                                    BorderThickness="1"

                                    CornerRadius="12"

                                    Padding="16,14"

                                    Margin="0,0,0,4">

                                <StackPanel>

                                    <TextBlock Text="{DynamicResource Str_WelcomeSandboxTitle}"

                                               FontFamily="{StaticResource UiFontFamily}"

                                               FontWeight="SemiBold"

                                               Foreground="{StaticResource PrimaryForegroundBrush}"

                                               Margin="0,0,0,6" />

                                    <TextBlock Text="{DynamicResource Str_WelcomeSandboxBody}"

                                               Style="{StaticResource BodyTextStyle}"

                                               TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>



                            <Border Background="{StaticResource CardElevatedBrush}"

                                    BorderBrush="{StaticResource CardBorderBrush}"

                                    BorderThickness="1"

                                    CornerRadius="12"

                                    Padding="16,14"

                                    Margin="0,0,0,10">

                                <StackPanel>

                                    <TextBlock Text="{DynamicResource Str_WelcomeSmartScreenTitle}"

                                               FontFamily="{StaticResource UiFontFamily}"

                                               FontWeight="SemiBold"

                                               Foreground="{StaticResource PrimaryForegroundBrush}"

                                               Margin="0,0,0,6" />

                                    <TextBlock Text="{DynamicResource Str_WelcomeSmartScreenBody}"

                                               Style="{StaticResource BodyTextStyle}"

                                               TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>



                    <Border Grid.Row="1"

                            Background="{StaticResource CardBrush}"

                            BorderBrush="{StaticResource CardBorderBrush}"

                            BorderThickness="0,1,0,0"

                            Padding="32,18,32,28">

                        <StackPanel>

                            <CheckBox x:Name="DontShowWelcomeAgainCheckBox"

                                      Content="{DynamicResource Str_DontShowWelcomeAgain}"

                                      FontFamily="{StaticResource UiFontFamily}"

                                      HorizontalAlignment="Center"

                                      Margin="0,0,0,16"

                                      Foreground="{StaticResource SubtleForegroundBrush}" />



                            <Button x:Name="WelcomeGetStartedButton"

                                    Content="{DynamicResource Str_GetStarted}"

                                    Style="{StaticResource PrimaryButtonStyle}"

                                    MinWidth="300"

                                    MinHeight="52"

                                    Padding="36,14"

                                    FontSize="15"

                                    HorizontalAlignment="Center"

                                    Click="WelcomeGuideDismiss_Click" />

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

        </Border>

    </Grid>

</Window>


