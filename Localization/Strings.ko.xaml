                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="Str_WindowTitle">Sandbox Timeline</system:String>
    <system:String x:Key="Str_AppTitle">Sandbox Timeline</system:String>
    <system:String x:Key="Str_GlobalHotkeyDisplay">Ctrl + Win + Z</system:String>
    <system:String x:Key="Str_SubtitleFormat">PC용 {0} — 즉시 스냅샷 &amp; 안전한 앱 테스트</system:String>
    <system:String x:Key="Str_LicenseBadgeFree">무료</system:String>
    <system:String x:Key="Str_LicenseBadgePremium">프리미엄</system:String>

    <system:String x:Key="Str_SystemTimeSlider">시스템 시간 슬라이더</system:String>
    <system:String x:Key="Str_SystemTimeSliderDesc">왼쪽은 과거 스냅샷, 오른쪽은 지금 PC 상태입니다. 슬라이더를 움직여 되돌릴 시점을 고르세요.</system:String>
    <system:String x:Key="Str_TimelinePast">🕒 과거 (Past State)</system:String>
    <system:String x:Key="Str_TimelineCurrent">⚡ 현재 (Current State)</system:String>
    <system:String x:Key="Str_TimelineSliderToolTip">과거 스냅샷(왼쪽)에서 현재 상태(오른쪽)까지 시간축을 이동합니다.</system:String>

    <system:String x:Key="Str_NoSnapshotsYet">아직 스냅샷이 없습니다</system:String>
